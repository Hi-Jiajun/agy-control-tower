{
  "control-tower-session-start": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/ct-hook.mjs SessionStart",
        "timeout": 5
      }
    ]
  },
  "control-tower-pre-invocation": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/ct-hook.mjs PreInvocation",
        "timeout": 5
      }
    ]
  },
  "control-tower-pre-tool-use": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|call_mcp_tool|mcp_.*apply_edits|apply_edits",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/ct-hook.mjs PreToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "control-tower-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/ct-hook.mjs Stop",
        "timeout": 5
      }
    ]
  }
}
