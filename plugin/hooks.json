{
  "control-tower-session-start": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/ct-hook.mjs SessionStart",
        "timeout": 5
      }
    ]
  },
  "control-tower-pre-invocation": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/ct-hook.mjs PreInvocation",
        "timeout": 5
      }
    ]
  }
}
