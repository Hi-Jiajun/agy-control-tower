#!/usr/bin/env bash
# 本地 Git pre-commit 合规门禁：
# 1) 全仓隐私脱敏、零间隔号、零危险递归删除命令检查
# 2) package.json / plugin/plugin.json / plugin/sidecars/tower/package.json 版本一致性校验
# 3) 若存在 agy CLI，运行 agy plugin validate --strict ./plugin
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_ROOT"

NODE_BIN="$(command -v node || true)"
if [ -z "$NODE_BIN" ]; then
  echo "错误: pre-commit 需要 node 运行时" >&2
  exit 1
fi

"$NODE_BIN" - <<'JS'
import { lstatSync, readdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

const rootPkg = JSON.parse(readFileSync('package.json', 'utf8'));
const pluginJson = JSON.parse(readFileSync('plugin/plugin.json', 'utf8'));
const sidecarPkg = JSON.parse(readFileSync('plugin/sidecars/tower/package.json', 'utf8'));

if (rootPkg.version !== pluginJson.version || sidecarPkg.version !== pluginJson.version) {
  console.error(
    `版本不一致: root=${rootPkg.version}, plugin=${pluginJson.version}, sidecar=${sidecarPkg.version}`
  );
  process.exit(1);
}

const forbHome = '/' + 'home' + '/';
const forbUsers = '/' + 'Users' + '/';
const forbIp = '192.' + '168.';
const forbDot = String.fromCharCode(0x00b7);
const forbRm1 = 'rm ' + '-rf';
const forbRm2 = 'rm ' + '-fr';
const uuidRe = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;

const SKIP_DIRS = new Set(['.git', '.agents', 'node_modules', '__pycache__', 'tmp']);

function scan(dir) {
  for (const ent of readdirSync(dir, { withFileTypes: true })) {
    if (SKIP_DIRS.has(ent.name)) continue;
    const full = join(dir, ent.name);
    if (ent.isDirectory()) {
      scan(full);
      continue;
    }
    const st = lstatSync(full);
    if (st.isSymbolicLink() || !st.isFile()) continue;
    const raw = readFileSync(full);
    if (raw.includes(0)) continue;
    const txt = raw.toString('utf8');
    if (txt.includes(forbHome)) throw new Error(`个人路径泄漏于 ${full}`);
    if (txt.includes(forbUsers)) throw new Error(`个人路径泄漏于 ${full}`);
    if (txt.includes(forbIp)) throw new Error(`内网 IP 泄漏于 ${full}`);
    if (uuidRe.test(txt)) throw new Error(`静态 UUID 泄漏于 ${full}`);
    if (txt.includes(forbDot)) throw new Error(`非法间隔号字符出现在 ${full}`);
    if (txt.includes(forbRm1) || txt.includes(forbRm2)) {
      throw new Error(`禁止出现的删除命令字面量存在于 ${full}`);
    }
  }
}

scan('.');
console.log(`OK: 隐私脱敏、零间隔号与版本一致性校验通过 (v${pluginJson.version})`);
JS

if command -v agy >/dev/null 2>&1; then
  agy plugin validate --strict ./plugin >/dev/null
  echo "OK: agy plugin validate --strict ./plugin 零警告通过"
fi
